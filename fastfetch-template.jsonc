// Reference: https://iniox.github.io/#matugen/templates
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 0,
            "right": 2
        },
        "color": {
            "1": "{{colors.primary.default.hex}}", // Void logo primary
            "2": "{{colors.secondary.default.hex}}" // Void logo accent
        }
    },
    "display": {
        "separator": " 󰜴 ",
        "color": {
            "keys": "{{colors.primary.default.hex}}",
            "title": "{{colors.primary.default.hex}}"
        }
    },
    "modules": [
        "title",
        "separator",
        // --- Software Section ---
        {
            "type": "os",
            "key": " os",
            "format": "{3}" 
        },
        {
            "type": "kernel",
            "key": " kr",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "uptime",
            "key": "󱎫 up",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "packages",
            "key": "󰏖 pk",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "------------"
        },
        // --- Hardware Section ---
        {
            "type": "cpu",
            "key": " cpu",
            "keyColor": "{{colors.primary.default.hex}}",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "󰢮 gpu",
            "keyColor": "{{colors.secondary.default.hex}}",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": " mem",
            "keyColor": "{{colors.tertiary.default.hex}}",
            "format": "{1} / {2}"
        },
        {
            "type": "swap",
            "key": " swp",
            "keyColor": "{{colors.primary.default.hex}}",
            "format": "{1} / {2}"
        },
        {
            "type": "custom",
            "format": "------------"
        },
        // --- Environment Section ---
        {
            "type": "shell",
            "key": " sh",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "terminal",
            "key": " tm",
            "keyColor": "{{colors.secondary.default.hex}}"
        },
        {
            "type": "terminalfont",
            "key": " tf",
            "keyColor": "{{colors.tertiary.default.hex}}"
        },
        {
            "type": "wm",
            "key": " wm",
            "keyColor": "{{colors.primary.default.hex}}"
        },
        {
            "type": "custom",
            "format": "------------"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}